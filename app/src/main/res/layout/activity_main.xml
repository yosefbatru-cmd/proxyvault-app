<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/pv_bg">
    <com.google.android.material.appbar.AppBarLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/pv_surface">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:title="ProxyVault" app:titleTextColor="@color/pv_accent" app:menu="@menu/main_menu" />
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" app:layout_behavior="@string/appbar_scrolling_view_behavior" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your Wire. Your Rules." android:textColor="@color/pv_muted" android:textSize="13sp" android:layout_marginBottom="12dp" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Select profile" app:boxBackgroundMode="outline" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
                <AutoCompleteTextView android:id="@+id/spinnerProfiles" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:textColor="@color/pv_text" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="@color/pv_card" app:cardCornerRadius="12dp" app:strokeColor="@color/pv_accent_dim" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/tvMode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SSH DIRECT" android:textColor="@color/pv_accent" android:textStyle="bold" android:textSize="14sp" />
                    <TextView android:id="@+id/tvHost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="—" android:textColor="@color/pv_text" android:textSize="16sp" />
                    <TextView android:id="@+id/tvLocalPort" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Local :1080" android:textColor="@color/pv_muted" android:textSize="13sp" />
                    <TextView android:id="@+id/tvNotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="No notes" android:textColor="@color/pv_muted" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/tvLiveStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Idle" android:textColor="@color/pv_text" android:textSize="14sp" android:minHeight="40dp" />
            <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/pv_muted" android:textSize="12sp" android:layout_marginBottom="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnConnect" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/connect" android:textAllCaps="false" app:backgroundTint="@color/pv_accent" android:textColor="@color/pv_bg" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRefresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Refresh profiles" android:textAllCaps="false" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:strokeColor="@color/pv_accent_dim" android:textColor="@color/pv_accent" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
